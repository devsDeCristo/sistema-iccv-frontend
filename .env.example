# Copie para .env (usado no `yarn dev`).
# Em Docker, este valor NÃO é lido em runtime: o Vite o embute no bundle
# durante o build, então ele é passado como build-arg VITE_API_URL.
VITE_API_URL=http://localhost:5000

# Liga o módulo de pagamento (config/env/index.ts compara com a string 'true').
# Também é build-time: mudar exige rebuild da imagem.
# VITE_MODULE_PAYMENT saiu: a cobrança online agora é ligada por igreja, na
# tela de Configurações › Pagamentos (dev e super admin). Ver Church.modulePayment.

# Captcha do login (Cloudflare Turnstile), pedido depois de 2 senhas erradas.
# Chave do SITE (pública); a SECRETA vai no backend (TURNSTILE_SECRET_KEY).
# Vazio: o captcha não aparece. Build-time, como as outras.
VITE_TURNSTILE_SITE_KEY=
