# Copie para .env (usado no `yarn dev`).
# Em Docker, este valor NÃO é lido em runtime: o Vite o embute no bundle
# durante o build, então ele é passado como build-arg VITE_API_URL.
VITE_API_URL=http://localhost:5000

# Liga o módulo de pagamento (config/env/index.ts compara com a string 'true').
# Também é build-time: mudar exige rebuild da imagem.
VITE_MODULE_PAYMENT=false
